<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted servers often run on plain http in a home network, so
     cleartext is allowed. Hosted servers use https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
