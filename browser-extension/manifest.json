{
  "manifest_version": 3,
  "name": "OpenTick – LinkedIn enrichment",
  "version": "2.0.0",
  "description": "Fills your OpenTick contacts' work history and education from LinkedIn, using your own logged-in session.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["extract.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
